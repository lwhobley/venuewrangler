# Cloudflare Pages security headers for the static marketing/join site.
# script-src/style-src keep 'unsafe-inline' because the pages ship inline
# scripts and <style> blocks; the remaining directives still block framing,
# object embeds, and cross-origin exfiltration to anything but the API.
#
# HSTS is set here as well as by helmet on the API, because this site serves
# the invite/join flow and the tokens that go with it. `preload` is
# deliberately omitted: submitting to the browser preload list is effectively
# irreversible for months and would bind every current and future subdomain to
# HTTPS. Add it only as a separate, deliberate decision once every subdomain is
# confirmed HTTPS-only.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://venue-wrangler-api-c57mm72zpa-ue.a.run.app; media-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Apple fetches this through its CDN and requires application/json. The file
# is deliberately extensionless (Apple mandates the exact name), so Pages has
# nothing to infer a type from and would otherwise serve it as a generic
# binary stream, which the CDN rejects — Universal Links then silently fall
# back to opening Safari with no error anywhere.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600

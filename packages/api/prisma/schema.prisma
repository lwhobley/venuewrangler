  toGuest      Guest    @relation("GuestHouseholdTo", fields: [toGuestId], references: [id], onDelete: Cascade)

  @@unique([fromGuestId, toGuestId])
  @@index([venueId])
  @@index([toGuestId])
}

model GuestCrmNote {
  id         String   @id @default(cuid())
  venueId    String
  guestId    String
  kind       String
  text       String
  occurredOn String?
  authorName String?

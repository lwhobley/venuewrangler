model User {
  id                        String                      @id @default(cuid())
  email                     String?                     @unique
  phone                     String?                     @unique
  emailVerifiedAt           DateTime?
  emailVerificationCodeHash String?
  emailVerificationSentAt   DateTime?
  termsAcceptedAt           DateTime?
  passwordResetCodeHash     String?
  passwordResetExpiresAt    DateTime?
  passwordResetSentAt       DateTime?
  failedSignInCount         Int                         @default(0)
  lockedUntil               DateTime?
  createdAt                 DateTime                    @default(now())
  // One profile per venue — a user with multi-venue access has multiple rows.
  profiles                  Profile[]
  sessions                  Session[]
  accounts                  AuthAccount[]
  password                  PasswordCredential?
  joinRequests              WorkplaceJoinRequest[]      @relation("WorkplaceJoinRequestUser")
  decidedJoinRequests       WorkplaceJoinRequest[]      @relation("WorkplaceJoinRequestDecider")
  joinRequestEvents         WorkplaceJoinRequestEvent[]
  attestedDevices           DeviceAttestation[]
  attestationChallenges     AttestationChallenge[]
}

/// An Apple App Attest key attested for one install of the app on one device.
/// Deliberately keyed to the *user*, not a Profile or Venue: a physical device
/// belongs to a person, who may hold memberships at several venues. It
/// therefore carries no venueId and must stay out of VENUE_SCOPED_MODELS
/// (see prisma/tenant-scope.ts).
model DeviceAttestation {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Base64 App Attest key identifier (SHA-256 of the attested public key).
  keyId       String    @unique
  /// PEM-encoded public key extracted from the verified attestation.
  publicKey   String
  /// Apple's monotonic assertion counter. Must strictly increase; a replayed
  /// assertion carries an equal or lower counter and is rejected.
  signCount   Int       @default(0)
  /// 'production' or 'development'. A development attestation must never be
  /// accepted by a production API.
  environment String
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?

  @@index([userId])
}

/// Single-use, short-lived nonce binding an attestation or assertion to one
/// server-issued request, so a captured payload cannot be replayed later.
model AttestationChallenge {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  value      String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([consumedAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId, provider])
}

model PasswordCredential {
  id           String   @id @default(cuid())
  userId       String   @unique
  passwordHash String
  salt         String
  iterations   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Venue {
  id                            String                    @id @default(cuid())
  name                          String
  latitude                      Float
  longitude                     Float
  geofenceRadiusM               Float
  // IANA timezone (e.g. "America/New_York"), required (VW-24). Every venue
  // creation path now resolves a concrete value (defaulting to "UTC" if the
  // caller sends none) before writing, so this can no longer silently be
  // absent — a null timezone previously let payroll and schedule
  // day-boundary math desync between server UTC and the venue's actual
  // business day for any venue that never set one explicitly.
  timezone                      String                    @default("UTC")
  code                          String                    @unique
  phone                         String?
  address                       String?
  venueType                     String?
  staffRange                    String?
  weeklyLaborBudgetHours        Float?
  // Venue-wide publish markers. Superseded by SchedulePublication for the
  // per-week state; kept because existing rows are the only record of what was
  // published before that table existed.
  schedulePublishedAt           DateTime?
  schedulePublishedById         String?
  scheduleUpdatedAfterPublishAt DateTime?
  // Availability lock window. Staff set availability for upcoming pay periods;
  // a period locks once it begins, unless availabilityUnlocked is set venue-wide.
  payPeriodAnchor               String?
  payPeriodLengthDays           Int                       @default(14)
  availabilityUnlocked          Boolean                   @default(false)
  earlyClockInWindowMin         Int                       @default(10)
  subscriptionStatus            SubscriptionStatus?
  subscriptionPlatform          SubscriptionPlatform?
  leadsWebhookSecret            String?
  createdAt                     DateTime                  @default(now())
  updatedAt                     DateTime                  @updatedAt
  profiles                      Profile[]
  shifts                        ScheduleShift[]
  shiftSwaps                    ShiftSwap[]
  availability                  Availability[]
  conversations                 Conversation[]
  messages                      Message[]
  conversationReads             ConversationRead[]
  chatImages                    ChatImage[]
  notifications                 NotificationEvent[]
  pushTokens                    PushToken[]
  timeEntries                   TimeEntry[]
  blackoutDates                 BlackoutDate[]
  schedulePublications          SchedulePublication[]
  staffRequests                 StaffRequest[]
  guests                        Guest[]
  guestHouseholdLinks           GuestHouseholdLink[]
  guestCrmNotes                 GuestCrmNote[]
  reservations                  Reservation[]
  floorPlans                    FloorPlan[]
  floorTables                   FloorTable[]
  tables                        TableState[]
  subscriptions                 Subscription[]
  subscriptionEvents            SubscriptionEvent[]
  crmLeads                      CrmLead[]
  crmNotes                      CrmNote[]
  posChecks                     PosCheck[]
  scheduleTemplates             ScheduleTemplate[]
  notificationReads             NotificationRead[]
  waitlistEntries               Waitlist[]
  tableAssignments              TableAssignment[]
  posConnections                PosConnection[]
  posLaborPunches               PosLaborPunch[]
  crmActivityLogs               CrmActivityLog[]
  crmBeos                       CrmBeo[]
  crmContracts                  CrmContract[]
  emailTemplates                EmailTemplate[]
  reservationHolds              ReservationHold[]
  paymentMethods                PaymentMethod[]
  invoices                      Invoice[]
  venueRoles                    VenueRole[]
  teams                         Team[]
  scheduleEmailEvents           ScheduleEmailEvent[]
  payrollExports                PayrollExport[]
  reservationConnections        ReservationConnection[]
  reservationSyncEvents         ReservationSyncEvent[]
  barInventoryItems             BarInventoryItem[]
  barInventoryMovements         BarInventoryMovement[]
  prepBoardItems                PrepBoardItem[]
  staffOnboardingTasks          StaffOnboardingTask[]
  logbookEntries                LogbookEntry[]
  checklistTemplateItems        ChecklistTemplateItem[]
  checklistCompletions          ChecklistCompletion[]
  auditLogs                     AuditLog[]
  managerGoals                  ManagerGoal[]
  venueEvents                   VenueEvent[]
  scheduleMemoryNotes           ScheduleMemoryNote[]
  floorChairs                   FloorChair[]
  reservationSetting            ReservationSetting?
  tableStateHistory             TableStateHistory[]
  invites                       Invite[]
  aiUsageEvents                 AiUsageEvent[]
  aiBudgetReservations          AiBudgetReservation[]
  joinRequests                  WorkplaceJoinRequest[]
  joinRequestEvents             WorkplaceJoinRequestEvent[]
  eventExecutionWorkspaces      EventExecutionWorkspace[]
  documents                     VenueDocument[]
}

model Profile {
  id                         String               @id @default(cuid())
  userId                     String?
  tokenIdentifier            String?
  email                      String
  fullName                   String
  role                       Role
  jobTitle                   String
  phone                      String?
  altPhone                   String?
  address                    String?
  dateOfBirth                DateTime?
  certifications             String[]             @default([])
  venueId                    String?
  membershipStatus           MembershipStatus?
  allAccess                  Boolean              @default(false)
  sickHoursAccrued           Float                @default(0.0)
  ptoHoursAccrued            Float                @default(0.0)
  trialEndsAt                DateTime?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  user                       User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  venue                      Venue?               @relation(fields: [venueId], references: [id], onDelete: SetNull)
  shifts                     ScheduleShift[]
  availability               Availability[]
  pushTokens                 PushToken[]
  timeEntries                TimeEntry[]
  staffRequests              StaffRequest[]       @relation("StaffRequestProfile")
  reviewedStaffRequests      StaffRequest[]       @relation("StaffRequestReviewer")
  sentMessages               Message[]
  conversationReads          ConversationRead[]
  notificationEvents         NotificationEvent[]
  notificationReads          NotificationRead[]
  requestedShiftSwaps        ShiftSwap[]          @relation("ShiftSwapRequesterProfile")
  targetShiftSwaps           ShiftSwap[]          @relation("ShiftSwapTargetProfile")
  crmNotes                   CrmNote[]
  crmActivityLogs            CrmActivityLog[]
  tableStateHistory          TableStateHistory[]
  servedTables               TableState[]         @relation("ServerTables")
  assignedLeads              CrmLead[]            @relation("AssignedLeads")
  createdScheduleMemoryNotes ScheduleMemoryNote[] @relation("ScheduleMemoryCreatedBy")
  uploadedDocuments          VenueDocument[]      @relation("DocumentUploader")
  aiUsageEvents              AiUsageEvent[]
  scheduleEmailEvents        ScheduleEmailEvent[]
  staffOnboardingTasks       StaffOnboardingTask[]

  @@unique([userId, venueId])
  @@index([userId])
  @@index([venueId])
  @@index([email])
  @@index([tokenIdentifier])
}

model ScheduleShift {
  id             String      @id @default(cuid())
  venueId        String
  profileId      String?
  // Sunday (YYYY-MM-DD) of the concrete calendar week this shift belongs to.
  weekStart      String
  dayIndex       Int
  startMinutes   Int
  endMinutes     Int
  jobTitle       String
  station        String
  notes          String?
  status         ShiftStatus
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  venue          Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  profile        Profile?    @relation(fields: [profileId], references: [id], onDelete: SetNull)
  requesterSwaps ShiftSwap[] @relation("ShiftSwapRequesterShift")
  targetSwaps    ShiftSwap[] @relation("ShiftSwapTargetShift")
  messages       Message[]
  staffRequests  StaffRequest[]

  @@index([venueId])
  @@index([profileId])
  @@index([venueId, weekStart])
  @@index([venueId, profileId, weekStart, dayIndex])
}

/**
 * Per-week publish state. The venue previously carried a single
 * schedulePublishedAt covering every week at once, so publishing one week
 * marked them all published and the manager's "Draft" badge could disagree with
 * what staff were already being shown. One row per published week; a week with
 * no row has never been published.
 */
model SchedulePublication {
  id            String   @id @default(cuid())
  venueId       String
  // Sunday (YYYY-MM-DD), matching ScheduleShift.weekStart.
  weekStart     String
  publishedAt   DateTime
  publishedById String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  venue         Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, weekStart])
  @@index([venueId])
}

model BlackoutDate {
  id        String   @id @default(cuid())
  venueId   String
  startDate DateTime
  endDate   DateTime
  reason    String
  createdBy String
  createdAt DateTime @default(now())
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
}

model ScheduleTemplate {
  id        String   @id @default(cuid())
  venueId   String
  name      String
  shifts    Json
  createdAt DateTime @default(now())
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
}

model ScheduleMemoryNote {
  id                 String   @id @default(cuid())
  venueId            String
  weekStart          String
  title              String
  detail             String
  createdByProfileId String?
  createdAt          DateTime @default(now())
  venue              Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdByProfile   Profile? @relation("ScheduleMemoryCreatedBy", fields: [createdByProfileId], references: [id], onDelete: SetNull)

  @@index([venueId])
  @@index([venueId, weekStart])
  @@index([venueId, createdAt])
  @@index([createdByProfileId])
}

model Availability {
  id           String   @id @default(cuid())
  venueId      String
  profileId    String
  // Sunday ('YYYY-MM-DD') of the calendar week this availability applies to.
  weekStart    String
  dayIndex     Int
  startMinutes Int
  endMinutes   Int
  available    Boolean
  // VW-27: had updatedAt but no createdAt, so first-set time was
  // unrecoverable. Existing rows backfill to the migration run time.
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  venue        Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // One availability row per profile per day per week — the app upserts per
  // day, so this turns retry/race duplicates into a constraint violation.
  @@unique([profileId, weekStart, dayIndex])
  @@index([profileId])
  @@index([venueId])
  @@index([profileId, weekStart])
  @@index([venueId, weekStart])
}

model StaffRequest {
  id                  String        @id @default(cuid())
  venueId             String
  profileId           String
  kind                String
  status              RequestStatus
  title               String
  details             String
  requestedForDate    String?
  requestedShiftId    String?
  requestedRangeStart String?
  requestedRangeEnd   String?
  availability        Json?
  reviewerId          String?
  reviewedAt          DateTime?
  responseNotes       String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  venue               Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  profile             Profile       @relation("StaffRequestProfile", fields: [profileId], references: [id], onDelete: Cascade)
  // VW-12: requestedShiftId and reviewerId carried no FK.
  requestedShift      ScheduleShift? @relation(fields: [requestedShiftId], references: [id], onDelete: SetNull)
  reviewer            Profile?      @relation("StaffRequestReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([venueId])
  @@index([profileId])
  @@index([status])
  @@index([requestedShiftId])
  @@index([reviewerId])
}

model Conversation {
  id              String             @id @default(cuid())
  venueId         String
  type            String
  name            String?
  memberIds       String[]
  isSystem        Boolean            @default(false)
  lastMessageAt   DateTime?
  lastMessageText String?
  roleName        String?
  shiftDate       String?
  // VW-26: previously absent, so a conversation could not be ordered by
  // creation or audited independent of lastMessageAt (null until the first
  // message is sent). Existing rows backfill to the migration run time —
  // the true creation time was never recorded and cannot be recovered.
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  venue           Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  messages        Message[]
  reads           ConversationRead[]

  @@index([venueId])
}

model Message {
  id             String         @id @default(cuid())
  conversationId String
  venueId        String
  // Nullable + SetNull so the team's chat history survives a member deleting
  // their account; the UI shows a fallback name for missing senders.
  senderId       String?
  text           String
  createdAt      DateTime       @default(now())
  // Used as an optimistic-concurrency guard for reaction toggles (read-modify
  // -write on the reactions JSON column) so two simultaneous reactions can't
  // silently drop one of them.
  updatedAt      DateTime       @default(now()) @updatedAt
  shiftId        String?
  swapId         String?
  imageUrl       String?
  reactions      Json?
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         Profile?       @relation(fields: [senderId], references: [id], onDelete: SetNull)
  venue          Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  shift          ScheduleShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  swap           ShiftSwap?     @relation(fields: [swapId], references: [id], onDelete: SetNull)
  chatImage      ChatImage?

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([venueId])
  @@index([shiftId])
  @@index([swapId])
}

model ConversationRead {
  id             String       @id @default(cuid())
  conversationId String
  profileId      String
  venueId        String
  readAt         DateTime     @default(now())
  venue          Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  profile        Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([conversationId, profileId])
  @@index([conversationId])
  @@index([profileId])
  @@index([venueId])
}

// S3 store for chat photo attachments. Served via an unguessable
// capability URL (GET /v1/chat/images/:id) that redirects to S3 pre-signed URL.
model ChatImage {
  id         String   @id @default(cuid())
  venueId    String
  mimeType   String
  s3Key      String
  uploadedBy String?
  messageId  String?  @unique
  // Set while an orphan cleanup owns this row. Message attachment only wins
  // while this remains null, preventing cleanup/send races.
  purgeStartedAt DateTime?
  createdAt  DateTime @default(now())
  venue      Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  message    Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([venueId])
  @@index([messageId, createdAt])
  @@index([purgeStartedAt])
}

/// Durable outbox for S3 deletion. Rows intentionally have no Venue FK so a
/// venue can be deleted transactionally while object deletion retries safely.
/// Wage records preserved past tenant offboarding.
///
/// TimeEntry.venue is onDelete: Cascade, so deleting a Venue destroyed every
/// employee's clock-in history — including staff who were not the account
/// being deleted and never consented. That directly contradicted TimeEntry's
/// own retention comment and the FLSA three-year payroll requirement.
///
/// Deliberately carries NO Venue foreign key and NO `venueId` field: the venue
/// is gone by the time these rows matter, and a live tenant key would both
/// break on cascade and pull this model into VENUE_SCOPED_MODELS, where the
/// isolation extension would make it unreadable. `originVenueId` is a
/// historical reference, not a tenant key — same reasoning as
/// ObjectDeletionJob above.
model RetainedTimeEntry {
  id                String    @id @default(cuid())
  originVenueId     String
  originVenueName   String?
  profileFullName   String?
  profileEmail      String?
  clockInAt         DateTime
  clockOutAt        DateTime?
  isOpen            Boolean
  breaks            Json?
  originCreatedAt   DateTime
  retainedAt        DateTime  @default(now())

  @@index([originVenueId])
  // Composite so the retention job's cutoff filter and its id tiebreak for
  // deterministic paging are both served by one index, not a filter-then-sort.
  @@index([originCreatedAt, id])
  @@index([retainedAt])
}

// Same pattern as RetainedTimeEntry: PosCheck/PosLaborPunch are onDelete:
// Cascade from Venue, so account deletion (the only place a Venue is ever
// deleted — see app.controller.ts) archives them here first. No Venue FK, so
// the row survives the cascade. Unlike TimeEntry these are not the departing
// account's own personal data (no profileId link), so nothing here needs
// pseudonymizing — they retain venue revenue/labor history the same way
// RetainedTimeEntry retains co-workers' wage history.
model RetainedPosCheck {
  id              String    @id @default(cuid())
  originVenueId   String
  originVenueName String?
  provider        String
  externalCheckId String
  tableLabel      String?
  serverName      String?
  guestName       String?
  openedAt        DateTime
  closedAt        DateTime?
  subtotalCents   Int
  taxCents        Int?
  tipCents        Int
  totalCents      Int
  status          String
  originUpdatedAt DateTime
  retainedAt      DateTime  @default(now())

  @@index([originVenueId])
  @@index([retainedAt])
}

model RetainedPosLaborPunch {
  id                 String    @id @default(cuid())
  originVenueId      String
  originVenueName    String?
  provider           String
  externalEmployeeId String
  employeeName       String
  clockInAt          DateTime
  clockOutAt         DateTime?
  regularMinutes     Int?
  overtimeMinutes    Int?
  regularPayCents    Int?
  overtimePayCents   Int?
  totalPayCents      Int?
  businessDate       String
  retainedAt         DateTime  @default(now())

  @@index([originVenueId])
  @@index([retainedAt])
}

// Same pattern as RetainedTimeEntry: StaffRequest.profile is onDelete:
// Cascade, and an APPROVED time-off/PTO/sick request is the paper trail for
// why sickHoursAccrued/ptoHoursAccrued changed on the departing account's
// Profile (see staff-requests.controller.ts) — the same wage/hour compliance
// category that justified retaining TimeEntry in the first place. Only
// approved requests are archived; pending/denied/cancelled ones never
// affected pay and are left to the ordinary Cascade. This IS the departing
// account's own personal data, so the name is pseudonymized like
// RetainedTimeEntry, not preserved like RetainedPosCheck.
model RetainedStaffRequest {
  id                  String    @id @default(cuid())
  originVenueId       String
  originVenueName     String?
  // Pseudonymized (deleted_user_<profileId>), same as RetainedTimeEntry —
  // this lets multiple retained records be correlated to the same former
  // employee without retaining their actual name.
  profileFullName     String?
  kind                String
  title               String
  details             String
  requestedForDate    String?
  requestedRangeStart String?
  requestedRangeEnd   String?
  responseNotes       String?
  originCreatedAt     DateTime
  originReviewedAt    DateTime?
  retainedAt          DateTime  @default(now())

  @@index([originVenueId])
  @@index([retainedAt])
}

model ObjectDeletionJob {
  id          String    @id @default(cuid())
  objectKeys  String[]
  status      String    @default("pending")
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([status, createdAt])
  @@index([completedAt])
}

// Private venue document library. Object bytes stay in S3; this row carries
// tenant ownership and display metadata used by the mobile app.
model VenueDocument {
  id           String           @id @default(cuid())
  venueId      String
  title        String
  fileName     String
  category     DocumentCategory
  mimeType     String
  sizeBytes    Int
  s3Key        String           @unique
  uploadedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  venue        Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  uploadedBy   Profile?         @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([venueId, createdAt])
  @@index([venueId, category])
  @@index([uploadedById])
}

model NotificationEvent {
  id        String             @id @default(cuid())
  venueId   String
  profileId String?
  audience  String
  kind      String
  title     String
  body      String
  createdAt DateTime           @default(now())
  venue     Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  // SetNull (not Cascade): deleting a profile must not erase venue-wide
  // notification history already delivered to other staff — mirrors
  // Message.senderId.
  profile   Profile?           @relation(fields: [profileId], references: [id], onDelete: SetNull)
  reads     NotificationRead[]

  @@index([venueId, createdAt])
  @@index([profileId, createdAt])
}

model NotificationRead {
  id             String            @id @default(cuid())
  notificationId String
  profileId      String
  venueId        String
  readAt         DateTime          @default(now())
  venue          Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  notification   NotificationEvent @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  profile        Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([notificationId, profileId])
  @@index([profileId])
  @@index([venueId])
}

model PushToken {
  id         String   @id @default(cuid())
  venueId    String
  profileId  String
  token      String
  platform   String
  enabled    Boolean
  lastSeenAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  venue      Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Scoped per venue, not global: the same physical device token is
  // legitimately registered at multiple venues for a staff member who works
  // more than one (notifications.service.ts already scopes delivery by
  // venueId, so this is a genuine multi-row case, not a collision to reject).
  @@unique([venueId, token])
  @@index([profileId])
  @@index([venueId])
  @@index([token])
}

// NOTE: a partial unique index exists in SQL only (Prisma cannot express it):
//   TimeEntry_profileId_open_key ON "TimeEntry"("profileId") WHERE "isOpen" = true
// (migration 20260608130000_clock_in_open_unique). If `prisma migrate dev`
// ever generates a DROP for that index, delete that statement before applying.
model TimeEntry {
  id                String    @id @default(cuid())
  venueId           String
  // Nullable + SetNull so wage records survive account deletion (FLSA
  // retention). profileFullName is snapshotted before the profile is removed.
  profileId         String?
  profileFullName   String?
  clockInAt         DateTime
  clockOutAt        DateTime?
  // Null for manager-approved administrative corrections that did not come
  // from a device punch. Never fabricate a 0,0 GPS fix for those records.
  clockInLat        Float?
  clockInLng        Float?
  clockInAccuracyM  Float?
  clockInMocked     Boolean?
  clockOutLat       Float?
  clockOutLng       Float?
  clockOutAccuracyM Float?
  clockOutMocked    Boolean?
  isOpen            Boolean
  breaks            Json?
  // Set when a punch reused an earlier day's exact coordinates from a coarse
  // (Wi-Fi/cell) fix. Recorded for manager review rather than blocking the
  // punch — see common/geofence.ts fixReplayVerdict.
  locationAnomaly   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  venue             Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  profile           Profile?  @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([venueId])
  @@index([venueId, clockInAt])
  @@index([profileId])
  @@index([profileId, isOpen])
  // VW-35: a standalone boolean index removed. Every real query filters
  // isOpen alongside venueId or profileId (never alone), and both are
  // already served by the composite indexes above.
}

model ShiftSwap {
  id                 String         @id @default(cuid())
  venueId            String
  // Nullable + SetNull (not Cascade): a shift swap is a two-party record, and
  // deleting ONE party's account (which removes every profile they hold,
  // across every venue — see app.controller.ts's account-delete flow) used to
  // cascade-delete the entire row, silently destroying the OTHER, still-active
  // party's pending/accepted swap with no trace. The row now survives with a
  // null party instead. Every read site must treat a null id as "that party
  // no longer has an account" rather than assuming it's always populated.
  requesterProfileId String?
  requesterShiftId   String
  targetProfileId    String?
  targetShiftId      String?
  status             String
  note               String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  venue              Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  requesterProfile   Profile?       @relation("ShiftSwapRequesterProfile", fields: [requesterProfileId], references: [id], onDelete: SetNull)
  targetProfile      Profile?       @relation("ShiftSwapTargetProfile", fields: [targetProfileId], references: [id], onDelete: SetNull)
  requesterShift     ScheduleShift  @relation("ShiftSwapRequesterShift", fields: [requesterShiftId], references: [id], onDelete: Cascade)
  targetShift        ScheduleShift? @relation("ShiftSwapTargetShift", fields: [targetShiftId], references: [id], onDelete: SetNull)
  messages           Message[]

  @@index([venueId])
  @@index([requesterProfileId])
  @@index([targetProfileId])
  @@index([requesterShiftId])
  @@index([targetShiftId])
}

model Guest {
  id              String        @id @default(cuid())
  venueId         String
  fullName        String
  phone           String?
  email           String?
  lifecycleStage  String?
  source          String?
  birthday        String?
  company         String?
  marketingOptIn  Boolean?
  favoriteTable   String?
  preferredServer String?
  dietaryNotes    String?
  tags            String[]
  notes           String?
  preferredContactMethod String?
  smsOptIn               Boolean?
  phoneticName           String?
  pronouns               String?
  honorific              String?
  guestTier              String?
  executiveRole          String?
  allergyNotes           String?
  allergyAirborne        Boolean?
  allergyRequiresChefSignoff Boolean?
  allergyRequiresManagerTouch Boolean?
  dietaryRegimen         String?
  waterPreference        String?
  beverageSignature      String?
  diningPace             String?
  serviceInteraction     String?
  physicalComfort        String?
  seatingPreferences     String?
  environmentAvoidance   String?
  nameLower       String?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  venue           Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  reservations    Reservation[]
  waitlistEntries Waitlist[]
  crmLeads        CrmLead[]
  householdLinksFrom GuestHouseholdLink[] @relation("GuestHouseholdFrom")
  householdLinksTo   GuestHouseholdLink[] @relation("GuestHouseholdTo")
  crmNotes           GuestCrmNote[]

  @@index([venueId])
  // VW-14: every guest lookup is already tenant-scoped, so a global
  // single-column index made Postgres filter a cross-tenant result set
  // instead of seeking directly. Composite indexes replace the old ones.
  // Deliberately not a unique constraint: two genuinely different guests
  // sharing a household or company phone number is a real, legitimate case
  // (this is a product decision, not an oversight — see VW-14 in the audit).
  @@index([venueId, phone])
  @@index([venueId, email])
  @@index([venueId, nameLower])
  @@index([venueId, guestTier])
}

model GuestHouseholdLink {

model BarInventoryItem {
  id            String                 @id @default(cuid())
  venueId       String
  name          String
  normalizedName String
  category      BarStockCategory
  area          String?
  unit          String
  parLevel      Float
  onHand        Float
  unitCostCents Int?
  supplier      String?
  sku           String?
  notes         String?
  lastCountedAt DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  venue         Venue                  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  movements     BarInventoryMovement[]

  @@index([venueId])
  @@index([venueId, category])
  @@index([venueId, name])
  @@unique([venueId, normalizedName])
  // A barcode has to identify one item: the SKU lookup takes the first match,
  // so two items sharing one opened whichever row came back. NULLs stay
  // distinct in Postgres, so items with no SKU are unconstrained.
  @@unique([venueId, sku])
}

model BarInventoryMovement {
  id             String               @id @default(cuid())
  operationId    String?
  venueId        String
  itemId         String
  movementType   BarStockMovementType
  quantity       Float
  previousOnHand Float
  nextOnHand     Float
  // Unit cost as of this movement. Without it, waste and comp were valued at
  // the item's current cost, so editing today's cost rewrote the value of
  // every past waste record. Null only for rows written before this column.
  unitCostCents  Int?
  notes          String?
  createdBy      String
  createdAt      DateTime             @default(now())
  venue          Venue                @relation(fields: [venueId], references: [id], onDelete: Cascade)
  item           BarInventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([venueId, createdAt])
  @@index([itemId, createdAt])
  @@unique([venueId, operationId])
}


  table          FloorTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  server         Profile?    @relation("ServerTables", fields: [serverId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([serverId])
  @@index([venueId])
  @@index([venueId, mergeGroupId])
}

model TableAssignment {
  id             String       @id @default(cuid())
  venueId        String
  reservationId  String?
  waitlistId     String?
  tableId        String
  holdType       HoldType
  startsAt       DateTime
  endsAt         DateTime

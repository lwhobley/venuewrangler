// NOTE: a SQL-only functional unique index (VenueRole_venue_name_key) exists
// on top of this schema — VW-28: duplicate role names were insertable
// despite the check-then-create in app.controller.ts already treating them
// as case-insensitively identical. Prisma can't represent a functional
// index; if `prisma migrate dev` ever generates a DROP for it, delete that
// statement before applying.
model VenueRole {
  id      String @id @default(cuid())
  venueId String
  name    String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
}

// VW-38: @@unique([venueId]) permits exactly one Team per venue, making
// `name` vestigial (there is nothing to distinguish it from) and this
// effectively a denormalized member-count counter for the venue, maintained
// by syncTeamMemberCount (common/team-sync.ts). Documented rather than
// changed: introducing real multi-team support is a product decision, not a
// schema defect to silently fix.
model Team {
  id          String @id @default(cuid())
  venueId     String
  name        String
  memberCount Int
  venue       Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId])
}


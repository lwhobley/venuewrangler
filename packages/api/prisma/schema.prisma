  depositCents        Int?
  depositDueDate      DateTime?
  menuAppetizers      String?
  menuEntrees         String?
  menuDesserts        String?
  menuBarPackage      String?
  specialRequirements String?
  internalNotes       String?
  assignedRepId       String?
  status              BeoStatus
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  venue               Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  lead                CrmLead?  @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contracts           CrmContract[]

  @@index([venueId])
  @@index([leadId])
  @@index([venueId, status])
}

model CrmContract {
  id                  String         @id @default(cuid())
  venueId             String
  leadId              String?
  beoId               String?
  contractNumber      String
  contractDate        DateTime?
  eventName           String?
  eventDate           DateTime?
  guestCount          Int?
  venueSpace          String?
  fbMinimumCents      Int?
  paymentSchedule     Json
  cancellationPolicy  String?
  forceMajeure        Boolean?
  liabilityWaiver     Boolean?
  customClauses       String[]
  clientSignatureName String?
  clientSignatureDate DateTime?
  status              ContractStatus
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  venue               Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  lead                CrmLead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  // VW-12: beoId carried no FK despite being validated tenant-scoped at
  // every write site (crm.controller.ts).
  beo                 CrmBeo?        @relation(fields: [beoId], references: [id], onDelete: SetNull)

  // Scoped per venue, not global: contractNumber is a random per-tenant
  // identifier (see makeContractNumber() in crm.controller.ts), and a global

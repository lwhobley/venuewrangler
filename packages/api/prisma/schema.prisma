  @@index([venueId])
  @@index([venueId, isActive])
}

model FloorTable {
  id               String              @id @default(cuid())
  // VW-09: the only floor model without its own venueId — FloorPlan and
  // FloorChair both have one, which made this an inconsistency rather than
  // a considered choice. Every current call site already scopes through
  // floorPlan.venueId or an active-plan allowlist before touching a table
  // (see floor.service.ts), so this was not a live cross-tenant read; it
  // closes the gap for whatever handler gets written next.
  venueId          String
  floorPlanId      String
  label            String
  shape            TableShape
  seats            Int
  seatLabelStyle   String?
  x                Float
  y                Float
  width            Float
  height           Float
  rotation         Float
  section          TableSection
  // Whole cents (25000 = $250.00), matching the *Cents convention used
  // everywhere else; the field name predates that convention.
  minSpend         Int
  isReservable     Boolean
  venue            Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  floorPlan        FloorPlan           @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  tableStates      TableState[]
  tableAssignments TableAssignment[]
  stateHistory     TableStateHistory[]

  @@index([venueId])
  @@index([floorPlanId])
  @@index([floorPlanId, section])
}

model FloorChair {
  id          String    @id @default(cuid())
  venueId     String
  floorPlanId String
  x           Float
  y           Float
  rotation    Float
  label       String?
  floorPlan   FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  venue       Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([floorPlanId])
  @@index([venueId])
}

model TableState {

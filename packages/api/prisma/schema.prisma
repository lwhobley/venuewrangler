  @@unique([venueId, provider])
  @@index([venueId])
}

model PosCheck {
  id              String         @id @default(cuid())
  venueId         String
  provider        PosProvider
  externalCheckId String
  tableLabel      String?
  tableId         String?
  serverName      String?
  serverId        String?
  guestName       String?
  guestId         String?
  openedAt        DateTime
  closedAt        DateTime?
  subtotalCents   Int
  taxCents        Int?
  tipCents        Int
  totalCents      Int
  discountCents   Int?
  compCents       Int?
  promoCents      Int?
  guestCount      Int?
  revenueCenter   String?
  tenderType      String?
  menuItems       Json?
  status          PosCheckStatus
  raw             Json?

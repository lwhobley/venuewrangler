model Invoice {
  id               String    @id @default(cuid())
  // Nullable + SetNull (VW-17): financial records are retained for tax and
  // accounting purposes past tenant offboarding, the same policy already
  // applied to AuditLog (VW-16) and wage records (RetainedTimeEntry). A
  // null-venueId invoice is simply unreachable through any tenant-scoped
  // query going forward — it is not migrated to a separate table because,
  // unlike TimeEntry, it carries no other tenant's data to protect from a
  // blanket Cascade.
  venueId          String?
  // Unique so retried Stripe invoice webhooks upsert one row per invoice.
  stripeInvoiceId  String    @unique
  amountCents      Int
  currency         String
  status           String
  invoiceUrl       String?
  hostedInvoiceUrl String?
  periodStart      DateTime
  periodEnd        DateTime
  createdAt        DateTime  @default(now())
  paidAt           DateTime?
  venue            Venue?    @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@index([venueId, createdAt])
}


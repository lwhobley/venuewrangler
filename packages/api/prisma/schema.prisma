  currency               String
  // Null for subscriptions that were never trial-based (e.g. a Stripe/Apple
  // subscription applied directly at 'active' with no trial period).
  trialStartedAt         DateTime?
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean
  cancelledAt            DateTime?
  externalSubscriptionId String?               @unique
  externalCustomerId     String?
  // One canonical RevenueCat customer allocation; never copied to covered venues.
  revenueCatSubscriberId String?               @unique
  billingSubscriptionId  String?
  billingSubscription    Subscription?         @relation("VenueBillingCoverage", fields: [billingSubscriptionId], references: [id], onDelete: SetNull)
  coveredSubscriptions   Subscription[]        @relation("VenueBillingCoverage")
  dataRetentionWarnedAt  DateTime?
  lastStripeEventAt      DateTime?
  lastRevenueCatEventAt  DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  venue                  Venue                 @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([status])

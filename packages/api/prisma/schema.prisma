  notifiedAt       DateTime?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  venue            Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  guest            Guest?            @relation(fields: [guestId], references: [id], onDelete: SetNull)
  tableAssignments TableAssignment[]

  @@index([guestId])
  @@index([venueId, requestedAt])
  @@index([venueId, status])
}

// A manager-imposed block on a date/time window so the venue won't accept
// reservations during it (staff meeting, private buyout, deep clean). The
// reservation create path warns when the requested time overlaps a hold.
model ReservationHold {
  id        String   @id @default(cuid())
  venueId   String
  startsAt  DateTime
  endsAt    DateTime
  reason    String
  createdAt DateTime @default(now())

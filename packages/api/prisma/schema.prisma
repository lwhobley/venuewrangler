  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  // VW-12: profileId carried no FK. Cascade matches StaffRequest.profileId —
  // a profile is only ever hard-deleted alongside its venue (see
  // app.controller.ts's account-deletion flow), which already cascades this
  // row via venueId, so this only changes behavior for a data-integrity
  // edge case, not a real deletion path.

  // Unique so retried/at-least-once labor webhook deliveries upsert one row per
  // employee per business day instead of double-counting hours and pay.
  @@unique([venueId, provider, externalEmployeeId, businessDate])
  @@index([venueId, businessDate])
  @@index([venueId, externalEmployeeId])
}

model CrmLead {
  id                  String           @id @default(cuid())
  venueId             String
  guestId             String?
  fullName            String
  email               String?
  phone               String?
  company             String?
  source              String?
  status              CrmLeadStatus
  tags                String[]
  assignedToId        String?
  marketingOptIn      Boolean?
  lastActivityAt      DateTime?
  estimatedValueCents Int?
  deletedAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  venue               Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  // VW-12: guestId carried no FK. SetNull matches Reservation.guestId and
  // Waitlist.guestId — deleting a guest must not delete the lead record.
  guest               Guest?           @relation(fields: [guestId], references: [id], onDelete: SetNull)
  assignedTo          Profile?         @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes               CrmNote[]

model AuditLog {
  id              String   @id @default(cuid())
  venueId         String?
  actorProfileId  String?
  actorName       String?
  actorRole       String?
  targetProfileId String?
  targetName      String?
  targetRole      String?
  entityType      String
  entityId        String?
  action          String
  summary         String
  ipAddress       String?
  userAgent       String?
  metadata        Json?
  createdAt       DateTime @default(now())
  // SetNull, not Cascade: this is the SOC2 audit trail. venueId is already
  // nullable (see VW-16) — a Cascade meant deleting a venue destroyed its own
  // audit history at exactly the moment (account/venue deletion) that
  // history matters most. The row survives with venueId null, the same
  // pattern RetainedTimeEntry uses for wage records.
  venue           Venue?   @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@index([venueId, createdAt])
  @@index([venueId, action])
  @@index([action, createdAt])
  @@index([targetProfileId])
  @@index([actorProfileId, createdAt])
  // Composite so the retention job's cutoff filter and its id tiebreak for
  // deterministic paging are both served by one index, not a filter-then-sort.
  @@index([createdAt, id])
}


  waitlist       Waitlist?    @relation(fields: [waitlistId], references: [id], onDelete: SetNull)
  table          FloorTable   @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId, startsAt])
  @@index([reservationId])
  @@index([waitlistId])
  @@index([venueId, startsAt])
}

model PosConnection {

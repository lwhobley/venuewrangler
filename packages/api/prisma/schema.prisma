model Invite {
  id        String   @id @default(cuid())
  venueId   String
  email     String?
  phone     String?
  // The bearer token itself is never stored — only its sha256 hash, so a DB
  // dump/backup leak can't yield usable signup links for pending invites
  // (mirrors Session.tokenHash). The plaintext lives only in memory for the
  // request that mints/rotates it, long enough to embed in the outgoing
  // email/deep-link.
  tokenHash String   @unique
  // Short, human-typeable join code (e.g. "VW-7K2Q9"); employees enter this to
  // join a team. The long token (hashed above) backs the /join universal
  // deep link.
  code      String?  @unique
  role      Role
  jobTitle  String
  createdBy String
  usedBy    String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // NOTE: two partial SQL-only indexes exist on top of this schema —
  // Invite_phone_idx, and Invite_pending_email_key (VW-25: one pending
  // invite per venue per email; superseded by application code in
  // app.controller.ts's createInvite and workforce.controller.ts's
  // inviteCheck before every insert). Prisma can't represent partial
  // indexes; if `prisma migrate dev` ever generates a DROP for either,
  // delete that statement before applying.
  @@index([email])
  @@index([venueId])
}

model WorkplaceJoinRequest {
  id           String                      @id @default(cuid())
  venueId      String
  userId       String
  status       WorkplaceJoinRequestStatus  @default(pending)
  decidedAt    DateTime?
  decidedById  String?
  decisionNote String?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  venue        Venue                       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user         User                        @relation("WorkplaceJoinRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy    User?                       @relation("WorkplaceJoinRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  events       WorkplaceJoinRequestEvent[]

  // NOTE: a partial SQL-only unique index
  // (WorkplaceJoinRequest_one_pending_per_user_venue_idx, WHERE status =
  // 'pending') exists on top of this schema. Prisma can't represent partial
  // indexes; if `prisma migrate dev` ever generates a DROP for it, delete
  // that statement before applying — dropping it re-opens duplicate pending
  // request races.
  @@index([venueId])
  @@index([userId])
  @@index([status])
  @@index([venueId, status])
  @@index([decidedById])
}

model WorkplaceJoinRequestEvent {
  id        String               @id @default(cuid())
  requestId String
  // Denormalized from the parent request at write time (see the SQL
  // functions that insert these rows) so this table is directly
  // tenant-scoped rather than only reachable safely through the
  // WorkplaceJoinRequest relation. SetNull, not Cascade, matching AuditLog's
  // pattern: an event's history outlives the venue it happened at.
  venueId   String?
  actorId   String?
  eventType String
  payload   Json?
  createdAt DateTime             @default(now())
  request   WorkplaceJoinRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  venue     Venue?               @relation(fields: [venueId], references: [id], onDelete: SetNull)
  actor     User?                @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([actorId])
  @@index([venueId])
}


# Template for Supabase Edge Function secrets. Copy to supabase/.env (gitignored) for local
# `supabase functions serve --env-file ./supabase/.env`; set the same keys as per-project
# secrets via `supabase secrets set --env-file ./supabase/.env` for hosted environments.
#
# Every value below is a placeholder. Do not fill this file with real secrets, and never
# commit supabase/.env. Edge Functions reading these must never return their raw values to
# the Flutter client (see docs/migration/flutter-supabase-rebuild-plan.md's hard
# constraints).

# ─── AI assistant: Groq (scheduling, staff import, inventory parsing, Wrangler assistant) ──
# Chosen over Gemini for its free tier — see docs/migration/flutter-supabase-rebuild-plan.md's
# "AI provider decision" note. GROQ_MODEL defaults to gpt-oss-120b (JSON-mode capable,
# $0.15/$0.60 per million input/output tokens as of 2026-10). Llama 3.3 70B and Llama 3.1 8B
# are enterprise-only on Groq and will 404 for a standard API key — do not use them here.
GROQ_API_KEY=replace-with-a-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
AI_MONTHLY_ORG_BUDGET_USD=10
AI_MONTHLY_ORG_WARNING_PERCENT=80
AI_MAX_OUTPUT_TOKENS=2048
AI_BUDGET_RESERVATION_TTL_SECONDS=120

# ─── Stripe (billing) ──────────────────────────────────────────────────────────────────────
# This Stripe account (acct_1SVQpXKFbgDlLMiE, "Loungeability LLC") has no test-mode
# counterpart and is shared with other, unrelated projects — STRIPE_SECRET_KEY below is
# therefore a LIVE secret key once filled in. Never run ad hoc checkout/subscription tests
# against it from a script; verify stripe-create-checkout/stripe-create-portal by reading
# their Stripe API calls, not by actually completing one, until a deliberate, confirmed test.
STRIPE_SECRET_KEY=replace-with-the-live-secret-key-from-the-stripe-dashboard
STRIPE_WEBHOOK_SECRET=replace-with-the-webhook-signing-secret-once-the-endpoint-is-created
# Connected-account events use a separate webhook signing secret. BEO deposits are
# direct charges to the organization's account; subscriptions stay on the platform.
STRIPE_CONNECT_WEBHOOK_SECRET=replace-with-the-connected-account-webhook-signing-secret
STRIPE_CONNECT_RETURN_URL=https://venuewrangler.com/billing?connect=returned
STRIPE_CONNECT_REFRESH_URL=https://venuewrangler.com/billing?connect=refresh
STRIPE_CRM_DEPOSIT_SUCCESS_URL=https://venuewrangler.com/billing?deposit=success
STRIPE_CRM_DEPOSIT_CANCEL_URL=https://venuewrangler.com/billing?deposit=cancelled
# Real existing recurring prices on this account (see Stripe dashboard -> Product catalog):
# venue_wrangler_monthly lookup key = price_1TmdDdKFbgDlLMiElEPZZ0pu ($99.99/mo)
# venue_wrangler_multi_venue_399 lookup key = price_1U1bFFKFbgDlLMiE2ss0qHGA ($399/mo)
STRIPE_PRICE_ID=price_1TmdDdKFbgDlLMiElEPZZ0pu
# https universal links (not raw venuewrangler:// deep links) per Stripe's documented mobile
# pattern — see site/.well-known/apple-app-site-association and site/billing/index.html, which
# is the static fallback page the app's associated-domains/App Links capability needs if the
# universal link itself doesn't reopen the app. Matches the legacy API's
# `${base}/billing?status=...` redirect exactly (packages/api/src/modules/app/
# app-billing.controller.ts) — not secret, but must match what venuewrangler.com actually
# serves at /billing.
STRIPE_CHECKOUT_SUCCESS_URL=https://venuewrangler.com/billing?status=success
STRIPE_CHECKOUT_CANCEL_URL=https://venuewrangler.com/billing?status=cancelled
STRIPE_PORTAL_RETURN_URL=https://venuewrangler.com/billing

# ─── Square (payroll push) ─────────────────────────────────────────────────────────────────
# square-oauth has NOT been exercised against a live Square sandbox app in this environment
# (no real credentials were available) — see supabase/functions/square-oauth/index.ts's header
# comment before relying on this in production.
SQUARE_APPLICATION_ID=replace-me
SQUARE_APPLICATION_SECRET=replace-me
SQUARE_REDIRECT_URI=https://replace-me.supabase.co/functions/v1/square-oauth/callback
SQUARE_API_BASE=https://connect.squareupsandbox.com
SQUARE_OAUTH_SCOPES=MERCHANT_PROFILE_READ LABOR_READ LABOR_WRITE TIMECARDS_READ TIMECARDS_WRITE

# ─── QuickBooks (payroll push) ──────────────────────────────────────────────────────────────
# quickbooks-oauth has NOT been exercised against a live Intuit sandbox app in this
# environment — see supabase/functions/quickbooks-oauth/index.ts's header comment.
QUICKBOOKS_CLIENT_ID=replace-me
QUICKBOOKS_CLIENT_SECRET=replace-me
QUICKBOOKS_REDIRECT_URI=https://replace-me.supabase.co/functions/v1/quickbooks-oauth/callback
QUICKBOOKS_OAUTH_SCOPES=com.intuit.quickbooks.accounting

# ─── Gusto (payroll push) ───────────────────────────────────────────────────────────────────
# gusto-oauth has NOT been exercised against a live Gusto sandbox app in this environment —
# see supabase/functions/gusto-oauth/index.ts's header comment. GUSTO_API_BASE defaults to the
# demo/sandbox host, not production.
GUSTO_CLIENT_ID=replace-me
GUSTO_CLIENT_SECRET=replace-me
GUSTO_REDIRECT_URI=https://replace-me.supabase.co/functions/v1/gusto-oauth/callback
GUSTO_API_BASE=https://api.gusto-demo.com

# ─── Payroll OAuth deep links ───────────────────────────────────────────────────────────────
# Where each {provider}-oauth/callback redirects the user's browser after a connect attempt,
# for the app to intercept via its registered URL scheme — not secret, but must match what the
# Flutter app actually registers (see apps/mobile/lib/features/integrations/README.md).
PAYROLL_OAUTH_SUCCESS_URL=venuewrangler://integrations/connected
PAYROLL_OAUTH_ERROR_URL=venuewrangler://integrations/error

# ─── Provider-token encryption at rest ──────────────────────────────────────────────────────
# AES-256-GCM key: exactly 32 random bytes, base64-encoded (e.g. `openssl rand -base64 32`).
# Used to encrypt Square/QuickBooks/Gusto OAuth tokens before they are written to
# payroll_connections. Never reuse this value across environments; rotating it invalidates
# every stored refresh token (every connected venue would need to reconnect).
PAYROLL_TOKEN_ENCRYPTION_KEY=replace-with-the-output-of-openssl-rand--base64-32

# ─── Device attestation ─────────────────────────────────────────────────────────────────────
# off | observe | enforce — the device-attestation Edge Function only actually implements
# off/observe (it never blocks a request regardless of this value); "enforce" is reserved for
# a future change to the function itself, per the migration plan's "begin in observe" hard
# requirement. See supabase/functions/device-attestation/index.ts.
DEVICE_ATTESTATION_MODE=observe
# iOS App Attest: cryptographically verified against Apple's real App Attestation Root CA
# (see supabase/functions/_shared/app-attest.ts). APP_ATTEST_TEAM_ID/BUNDLE_ID must match the
# real Apple Developer team ID and bundle identifier the app is signed with, since they're
# hashed into the expected rpIdHash check.
APP_ATTEST_TEAM_ID=replace-with-apple-team-id
APP_ATTEST_BUNDLE_ID=com.venuewrangler.app
# AES/HMAC key for the signed App Attest challenge token (same format as
# PAYROLL_TOKEN_ENCRYPTION_KEY: exactly 32 random bytes, base64-encoded, e.g.
# `openssl rand -base64 32`). Challenges are stored server-side and consumed once;
# see attestation_challenges_schema.sql and device-attestation/index.ts.
APP_ATTEST_CHALLENGE_SIGNING_KEY=replace-with-the-output-of-openssl-rand--base64-32
# Android Play Integrity: fully implemented, calls Google's real decodeIntegrityToken API.
PLAY_INTEGRITY_PROJECT_NUMBER=replace-me
PLAY_INTEGRITY_PACKAGE_NAME=com.venuewrangler.app
PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=replace-with-the-full-service-account-json-as-one-line

# ─── Push notifications (FCM / APNs) ────────────────────────────────────────────────────────
# Direct FCM HTTP v1 dispatch — see supabase/functions/notifications-send/index.ts. The whole
# Firebase service account JSON (project_id/client_email/private_key), as one line, from
# Firebase Console -> Project Settings -> Service accounts -> Generate new private key. Not the
# google-services.json client config (that's for the Android app itself, not this Edge
# Function). project_id inside this JSON is read directly, no separate FIREBASE_PROJECT_ID var.
FIREBASE_SERVICE_ACCOUNT=replace-with-the-full-service-account-json-as-one-line
# iOS uses native APNs dispatch; Android uses FCM. Configure APNS_KEY, APNS_KEY_ID,
# APNS_TEAM_ID, and APNS_BUNDLE_ID for the signed iOS app.
APNS_KEY=

# ─── Sentry (Edge Function side) ────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── Transactional email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_replace_me
EMAIL_FROM="Venue Wrangler <no-reply@venuewrangler.com>"

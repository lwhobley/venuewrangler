{
  "name": "venueflow-app",
  "private": true,
  "packageManager": "npm@11.12.1",
  "main": "expo-router/entry",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "brace-expansion@^1.1.7": "1.1.18",
    "brace-expansion@^5.0.5": "5.0.9",
    "decode-uri-component": "0.5.0",
    "deepmerge-ts@7.1.5": "8.0.0",
    "js-yaml": "4.3.1",
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "postcss": "8.5.25",
    "qs": "6.16.0",
    "uuid": "11.1.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:site": "node scripts/build-site.mjs",
    "build:marketing": "npm run build -w @venue-wrangler/marketing",
    "dev:marketing": "npm run dev -w @venue-wrangler/marketing",
    "api:dev": "npm run start:dev -w @venue-wrangler/api",
    "api:build": "npm run build -w @venue-wrangler/api",
    "api:prisma:generate": "npm run prisma:generate -w @venue-wrangler/api",
    "api:migrate:dev": "npm run prisma:migrate:dev -w @venue-wrangler/api",
    "doctor": "expo-doctor",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest run --config vitest.ui.config.mts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.59.0",
    "expo": "~57.0.21",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.16",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.21",
    "fast-uri": "^4.1.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "^5.12.0",
    "react-native-purchases": "^10.8.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "undici": "^8.9.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@emnapi/wasi-threads": "1.2.3",
    "@types/react": "~19.2.18",
    "@vitest/coverage-v8": "^5.0.0",
    "expo-doctor": "1.20.4",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
